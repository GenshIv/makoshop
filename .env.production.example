# Makoshop production configuration
# Copy this file to `.env` and fill in real values.
# The server loads `.env` automatically on startup (see pkg/config/env.go).
# NEVER commit the real .env — it is in .gitignore.

# --- Required ---

# JWT signing secret. Use a long random string, e.g.:
#   openssl rand -hex 32
MAKOSHOP_JWT_SECRET="CHANGE_ME_openssl_rand_hex_32"

# --- Server ---

# Bind address and HTTPS port.
MAKOSHOP_HOST="0.0.0.0"
MAKOSHOP_PORT="9090"
MAKOSHOP_SITE_URL="https://wszyst.pl"

# Canonical public base URL of the site (no trailing slash).
# Used for sitemaps, robots.txt and canonical/og: links.
# Set to your real domain in production.
MAKOSHOP_SITE_URL="https://www.yourdomain.com"

# --- TLS ---
# Choose ONE of the two options below.

# Option A: Automatic Let's Encrypt certificates (recommended for production).
# Set the domain(s) the server is allowed to serve, comma-separated.
# The server obtains and renews certificates automatically via ACME.
# Requires the domain's DNS to point at this server and ports 80/443 reachable.
MAKOSHOP_AUTOCERT_DOMAINS="yourdomain.com,www.yourdomain.com"
# Directory to cache obtained certificates (they persist across restarts).
MAKOSHOP_AUTOCERT_CACHE="/var/lib/makoshop/certs"

# Option B: Use your own certificate files (comment out Option A to use this).
# MAKOSHOP_TLS_CERT="/etc/makoshop/tls/cert.pem"
# MAKOSHOP_TLS_KEY="/etc/makoshop/tls/key.pem"

# Optional: plain-HTTP port that 301-redirects everything to HTTPS.
# Leave empty to disable the redirect listener.
MAKOSHOP_HTTP_PORT="8080"

# --- Database ---

# Path to the makodb data directory (sharded .db files live here).
MAKOSHOP_DB_PATH="/var/lib/makoshop/db"

# Number of DB shards (one per CPU core is a good default).
# Lower for small/local setups, higher for production with more cores.
MAKOSHOP_DB_NUM_SHARDS="16"

# Maximum total size across all shards, in bytes.
# 40 GB default. Tune to your disk/RAM budget.
MAKOSHOP_DB_MAX_TOTAL_SIZE="42949672960"

# Hash-table slots per shard. Higher = more memory, fewer collisions.
MAKOSHOP_DB_NUM_BUCKETS="5000000"

# --- Misc ---

# Default UI language (ru, en, ua, pl).
I18N_LANG="ru"
