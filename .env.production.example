# Makoshop production configuration
# Copy this file to `.env` and fill in real values.
# The server loads `.env` automatically on startup (see pkg/config/env.go).
# NEVER commit the real .env — it is in .gitignore.

# --- Required ---

# JWT signing secret. Use a long random string, e.g.:
#   openssl rand -hex 32
MAKOSHOP_JWT_SECRET="CHANGE_ME_openssl_rand_hex_32"

# --- Server ---

# Bind address and HTTPS port.
MAKOSHOP_HOST="0.0.0.0"
MAKOSHOP_PORT="9090"

# --- TLS (enable by setting both) ---

# Path to the TLS certificate and key. When both are set the server serves HTTPS.
# For a production domain use a real certificate (Let's Encrypt, etc.).
MAKOSHOP_TLS_CERT="/etc/makoshop/tls/cert.pem"
MAKOSHOP_TLS_KEY="/etc/makoshop/tls/key.pem"

# Optional: plain-HTTP port that 301-redirects everything to HTTPS.
# Leave empty to disable the redirect listener.
MAKOSHOP_HTTP_PORT="8080"

# --- Database ---

# Path to the makodb data directory (sharded .db files live here).
MAKOSHOP_DB_PATH="/var/lib/makoshop/db"

# --- Misc ---

# Default UI language (ru, en, ua, pl).
I18N_LANG="ru"
